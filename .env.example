# Copy to .env for local runs. Never commit real values.
# Client keys: comma-separated name:key pairs. Each client sends "Authorization: Bearer <key>".
GATEWAY_CLIENT_KEYS=local-dev:change-me
# Random string for hashing end-user ids (IPs) before they are stored.
USER_HASH_SALT=

# Providers
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Limits
RATE_LIMIT_CLIENT_PER_MINUTE=120
RATE_LIMIT_USER_PER_MINUTE=5
RATE_LIMIT_USER_PER_DAY=30
DAILY_BUDGET_USD=1.00

# Shared state. Leave empty to use in-memory stores (fine for one local process).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Traces to Langfuse over OTLP. Leave empty to keep traces local.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Guardrails: block or flag
INJECTION_MODE=block
INJECTION_THRESHOLD=0.7
